@page
@model StudentLibrary2.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Список книг";
}

<div class="container mt-4">

    <!-- Заголовок и кнопка добавления книги -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список книг</h2>
        <a asp-page="Create" class="btn btn-success">
            Добавить новую книгу
        </a>
    </div>

    <!-- Плитки книг -->
    <div class="row g-4">
        @foreach (var book in Model.Books)
        {
            <!-- Каждая карточка книги в колонке -->
            <div class="col-sm-6 col-md-4 col-lg-3">

                <!-- Карточка книги с тенью -->
                <div class="card h-100 shadow-sm" id="book-@book.Id">
                    <div class="card-body">

                        <!-- Заголовок книги с иконкой и обрезкой текста -->
                        <h5 class="card-title text-truncate">
                            📚 @book.Title
                        </h5>

                        <!-- Автор -->
                        <p class="card-text text-muted mb-1">
                            Автор: @book.Author.Name
                        </p>

                        <!-- Год публикации -->
                        <p class="card-text mb-1">
                            Год: <span class="badge bg-secondary">@book.Year</span>
                        </p>

                        <!-- Количество экземпляров -->
                        <p class="card-text mb-2">
                            Кол-во: <span class="badge bg-info">@book.Copies</span>
                        </p>

                        <!-- Кнопки действий -->
                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@book.Id" class="btn btn-sm btn-info">
                                Открыть
                            </a>
                            <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-warning">
                                Изменить
                            </a>
                            <a asp-page="Delete" asp-route-id="@book.Id" class="btn btn-sm btn-danger">
                                Удалить
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        }
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<!-- Подключение SignalR для обновления карточек книг в реальном времени -->
<script>
    // Создаём подключение к хабу BookHub
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/bookHub") // Путь к хабу на сервере
        .build();

    // Слушаем событие "BookUpdated", отправляемое сервером
    connection.on("BookUpdated", function (book) {
        // Ищем существующую карточку по id
        const existingCard = document.getElementById("book-" + book.id);

        // HTML для новой/обновлённой карточки
        const html = `
            <div class="card h-100 shadow-sm" id="book-${book.id}">
                <div class="card-body">
                    <h5 class="card-title text-truncate">📚 ${book.title}</h5>
                    
                    <p class="card-text mb-1">Год: <span class="badge bg-secondary">${book.year}</span></p>
                    <p class="card-text mb-2">Кол-во: <span class="badge bg-info">${book.copies}</span></p>
                    <div class="d-flex justify-content-between">
                        <a href="/Books/Details?id=${book.id}" class="btn btn-sm btn-info">Открыть</a>
                        <a href="/Books/Edit?id=${book.id}" class="btn btn-sm btn-warning">Изменить</a>
                        <a href="/Books/Delete?id=${book.id}" class="btn btn-sm btn-danger">Удалить</a>
                    </div>
                </div>
            </div>
        `;

        if (existingCard) {
            // Если карточка уже есть — заменяем старую на новую
            existingCard.outerHTML = html;
        } else {
            // Если карточка новая — создаём div.col и добавляем в контейнер
            const container = document.querySelector(".row");
            const wrapper = document.createElement("div");
            wrapper.className = "col-sm-6 col-md-4 col-lg-3";
            wrapper.innerHTML = html;
            container.appendChild(wrapper);
        }
    });

    // Запуск подключения
    connection.start().catch(err => console.error(err.toString()));
</script>